# Ingresa tu API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_XXXXX

# Correo que RECIBE los mensajes del formulario (puede ser tu Gmail)
CONTACT_TO_EMAIL=tu-correo@example.com

# Correo que ENVÍA la notificación.
# Para pruebas usa: onboarding@resend.dev
# Para producción, usa un dominio verificado en Resend (ej: contact@tudominio.com)
RESEND_FROM_EMAIL=onboarding@resend.dev
