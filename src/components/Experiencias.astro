---
import { getExperiencias } from "@/utils/experiencias";

const experiencias = getExperiencias();
---

<section id="experiencia" class="section scroll-m-20 w-full mx-auto container lg:max-w-4xl md:max-w-2xl">
    <div class="mb-8">
        <h2 class="flex items-center text-3xl font-bold tracking-tight gap-x-3 text-black/80 dark:text-white">
            <svg class="size-8" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"></path><path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"></path><path d="M12 12l0 .01"></path><path d="M3 13a20 20 0 0 0 18 0"></path></svg>
            Experiencia
        </h2>
        <div class="mt-3 h-px w-50 bg-gradient-to-r from-amber-300/70 to-transparent" aria-hidden="true"></div>
    </div>

    <ol class="relative border-l border-gray-300 dark:border-gray-600 ml-3 space-y-10">
        {
            experiencias.map((exp) => (
                <li class="ml-6">
                    <span class="absolute -left-[7px] mt-1.5 size-3.5 rounded-full bg-amber-400" aria-hidden="true"></span>
                    <div class="flex flex-col gap-1">
                        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                            <h3 class="text-xl font-bold text-gray-900 dark:text-white">{exp.puesto}</h3>
                            <time class="font-mono text-sm text-amber-600 dark:text-amber-400">{exp.periodo}</time>
                        </div>
                        <p class="font-semibold text-amber-600 dark:text-amber-400">{exp.empresa}</p>
                        <p class="mt-1 text-gray-600 dark:text-gray-300">{exp.descripcion}</p>
                        <div class="mt-3 flex flex-wrap gap-2">
                            {
                                exp.tecnologias.map((tech) => (
                                    <span class="rounded-full border border-amber-300/60 bg-amber-300/10 px-3 py-1 font-mono text-xs font-medium text-amber-700 dark:text-amber-300">
                                        {tech}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                </li>
            ))
        }
    </ol>
</section>