    </article>
</section>

<script>
    window.onload = () => {
        const $ = (arg: string) => document.querySelector(arg)
    
        const button = $("#btnDownloadCv");
    
        if(button) {
            button?.addEventListener("click", () => {
                const fileUrl = "/public/curriculum/Oscar_Palma_Abud_CV.pdf";
                const fileName = "CV_Oscar_Palma_Abud.pdf";
                
                // Creamos un enlace oculto en memoria
                const link = document.createElement("a");
                link.href = fileUrl;
                link.download = fileName;

                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });
        }
    }
</script>