---
import Layout from "@/layouts/layout.astro"
---
<Layout
  title="404 - Página no encontrada"
  nameContent="description"
  contenido="La página que buscas no existe. Vuelve al inicio del portafolio de Oscar Palma."
>
  <section class="min-h-[50dvh] flex flex-col items-center justify-center text-center py-24 gap-8">
    <h1 style="font-size: 150px;">404</h1>

    <div class="flex flex-col gap-3">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Página no encontrada</h1>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-md">
        La página que estás buscando no existe o fue movida. No te preocupes, siempre puedes volver al inicio.
      </p>
    </div>

    <a
      href="/"
      class="inline-flex cursor-pointer items-center gap-2 rounded-2xl bg-amber-300 px-6 py-3 text-base font-bold text-gray-950 transition hover:bg-amber-400"
    >
      Volver al inicio
    </a>
  </section>
</Layout>
